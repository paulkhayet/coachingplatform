# Copy to .env.local and fill in from your Supabase project (Project settings → API keys / Connect).

# Public values — safe in the browser. Use the publishable key (sb_publishable_…), never the secret key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Used to build links in emails (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# ── Server-only secrets below: never NEXT_PUBLIC_, never in the browser. ──

# Postgres connection that bypasses row-level security. Used by `npm run db:migrate`, by production
# deploys to apply migrations (scripts/migrate.mjs), and by the server for webhooks and bookings.
# Locally: the Session pooler string from Connect (port 5432; works over IPv4, unlike the db.* host).
# On Vercel: the Transaction pooler string (port 6543), which suits serverless functions.
# DATABASE_URL=postgresql://postgres.your-project-ref:YOUR-PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Stripe (Dashboard → Developers → API keys). Test keys (sk_test_…) locally and on previews;
# the live key only on the production deployment.
# STRIPE_SECRET_KEY=sk_test_xxx

# Webhook signing secret. Locally, from `stripe listen` (see app/README.md); on Vercel, from the
# Connect webhook endpoint at /api/stripe/webhook ("Events on connected accounts").
# STRIPE_WEBHOOK_SECRET=whsec_xxx

# Google Calendar connection (Google Auth Platform → Clients). Redirect URI: <site>/api/google/callback.
# GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxx

# Booking emails (confirmations, changes, reminders) through Resend, from no-reply@schedulefa.st.
# Resend → API keys → Create, with "Sending access" for schedulefa.st. Without it, emails are skipped.
# RESEND_API_KEY=re_xxx

# Protects /api/cron/reminders. Anything long and random (openssl rand -hex 32). The scheduler sends it
# as "Authorization: Bearer <CRON_SECRET>". The scheduler is Supabase pg_cron (migration 0016): put the same
# value in that project's Vault as `cron_secret`, and the endpoint address as `reminders_url`.
# CRON_SECRET=xxx
